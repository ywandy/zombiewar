[gd_resource type="Resource" script_class="InventoryProfile" load_steps=21 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/inventory/inventory_profile.gd" id="1_inventory_profile"]

[sub_resource type="Resource" id="InventoryProfile_knife"]
